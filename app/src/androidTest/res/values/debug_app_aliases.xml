<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The debug build type exports app_icon/app_name aliases into the androidTest APK.
         The test APK does not package the app's main resources, so provide lightweight
         test-only targets for those aliases. -->
    <item name="ic_launcher_debug" type="mipmap">@android:drawable/sym_def_app_icon</item>
    <item name="ic_launcher_round_debug" type="mipmap">@android:drawable/sym_def_app_icon</item>
    <string name="app_name_debug" translatable="false">Fcitx5 (Debug)</string>
</resources>
